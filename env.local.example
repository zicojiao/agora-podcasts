# ─── Gemini ───────────────────────────────────────────────────────────────────
# Server-side only. Your project must have access to the selected models.
GEMINI_API_KEY=

# Gemini 3.8 Flash TTS for two-speaker conversational audio. Optional override.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Text model used to write the episode script and the inserted answers.
# This is an ordinary public Gemini model, independent of the TTS model.
GEMINI_TEXT_MODEL=gemini-3.8-flash

# ─── Agora ────────────────────────────────────────────────────────────────────
# Required: Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# ─── PostHog (public browser analytics configuration) ────────────────────────────────────
# The app disables autocapture, recordings, person profiles, and sensitive content fields.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
